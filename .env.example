# Copy to .env. Same file works on CachyOS and inside WSL2.

# Pin an exact version once the first run works (e.g. 12.3.20261023-013714; tags are dated, there is no plain x.y.z). Both OSes pull
# their own image, and a Jellyfin DB migration can't be undone, so a version
# mismatch between the two sides can leave one of them unable to start.
JELLYFIN_TAG=latest

TZ=Europe/Budapest

# Host path of the media share (mounted from the rpi5). Libraries inside Jellyfin
# are added as /media/..., so this path never matters to the database.
MEDIA_DIR=/mnt/XS1000

# ext4 volume holding /config and /cache. Defaults: /mnt/jellyfin-config on
# Linux, /mnt/wsl/jellyfin-config in WSL2 (set by ./jf), only override if needed.
#CONFIG_DIR=
